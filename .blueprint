models:
    Article: {  }
    User: { name: string, email: string, email_verified_at: 'datetime nullable', password: string, remember_token: 'string nullable', sso_subject_id: 'string nullable', student_number: 'string nullable', staff_number: 'string nullable', role: "string default:'student'", last_login_at: 'datetime nullable' }
    Category: { slug: 'string:50 unique', name: 'string:100', icon: 'string:20 nullable', sort_order: 'integer default:0', relationships: { hasMany: Guide } }
    Guide: { category_id: 'id foreign:categories', tag: 'string:20 unique', slug: 'string:150 unique', title: 'string:255', summary: 'text nullable', status: 'enum:draft,published,archived default:draft', views_count: 'integer default:0', helpful_count: 'integer default:0', not_helpful_count: 'integer default:0', created_by_id: 'id foreign:users nullable', updated_by_id: 'id foreign:users nullable', published_at: 'timestamp nullable', relationships: { belongsTo: Category, hasMany: 'GuideStep, GuideVideo, GuideFeedback, GuideView' } }
    GuideStep: { guide_id: 'id foreign:guides', step_number: integer, content: text, relationships: { belongsTo: Guide } }
    GuideVideo: { guide_id: 'id foreign:guides', provider: 'enum:youtube,vimeo,upload default:youtube', video_url: 'string:500', duration_seconds: 'integer nullable', sort_order: 'integer default:0', relationships: { belongsTo: Guide } }
    GuideFeedback: { guide_id: 'id foreign:guides', user_id: 'id foreign:users nullable', is_helpful: boolean, comment: 'text nullable', relationships: { belongsTo: 'Guide, User' } }
    GuideView: { guide_id: 'id foreign:guides', user_id: 'id foreign:users nullable', viewed_at: 'timestamp nullable', relationships: { belongsTo: 'Guide, User' } }
    SearchLog: { query_text: 'string:255', normalized_query: 'string:255', result_count: integer, user_id: 'id foreign:users nullable', relationships: { belongsTo: User } }
    AuditLog: { actor_id: 'id foreign:users nullable', action: 'string:50', entity_type: 'string:50', entity_id: 'uuid nullable', metadata: 'json nullable', relationships: { belongsTo: 'User:actor_id' } }
